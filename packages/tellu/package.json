{
  "name": "tellu",
  "version": "0.0.2",
  "description": "Advanced telop (caption) rendering on PixiJS — multi-layer strokes, shadows, gradients, rich text and Japanese line breaking.",
  "type": "module",
  "license": "MIT",
  "author": "kazuito",
  "homepage": "https://tellujs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazuito/tellu.git",
    "directory": "packages/tellu"
  },
  "bugs": "https://github.com/kazuito/tellu/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "telop",
    "caption",
    "subtitle",
    "pixi",
    "pixijs",
    "remotion",
    "text",
    "stroke"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "pixi.js": "^8.21.0",
    "react": ">=18",
    "remotion": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "remotion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "remotion": "^4.0.534",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "tellu-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "tellu-source": "./src/react/index.ts",
      "default": "./dist/react.js"
    },
    "./remotion": {
      "tellu-source": "./src/remotion/index.ts",
      "default": "./dist/remotion.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./react": "./dist/react.js",
      "./remotion": "./dist/remotion.js",
      "./package.json": "./package.json"
    }
  }
}
